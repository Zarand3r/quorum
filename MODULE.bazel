# quorum — repo-wide Bazel workspace (Bzlmod).
#
# This file lives at the repo root, so ``bazel`` commands run from
# anywhere in the tree resolve back here. The workspace name matches the
# repo: a single bazel workspace covering whatever bazel-built work lands
# under ``projects/``. Projects without ``BUILD.bazel`` files are
# invisible to bazel.
#
# See https://bazel.build/external/module for the syntax reference.

module(
    name = "quorum",
    version = "0.0.0",
    compatibility_level = 1,
)

# --- Python (rules_python, hermetic toolchain) --------------------------------
bazel_dep(name = "rules_python", version = "0.40.0")

PYTHON_VERSION = "3.12"  # mirrors .python-version

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = PYTHON_VERSION,
    is_default = True,
)

# --- Per-project pip dependency hubs ------------------------------------------
# One hub per project keeps dependency sets isolated (a core repo invariant).
# Each reads a fully-pinned lock committed next to that project's BUILD.bazel.
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "thermolife_deps",
    python_version = PYTHON_VERSION,
    requirements_lock = "//projects/thermolife:requirements_lock.txt",
)
pip.parse(
    hub_name = "asal_deps",
    python_version = PYTHON_VERSION,
    requirements_lock = "//projects/quorum/asal:requirements_lock.txt",
)
use_repo(pip, "thermolife_deps", "asal_deps")

# Future rules (rules_rust / rules_go / rules_oci) and per-project pip hubs
# are added here as bazel-built work appears.
