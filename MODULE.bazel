# quorum — repo-wide Bazel workspace (Bzlmod).
#
# This file lives at the repo root, so ``bazel`` commands run from
# anywhere in the tree resolve back here. The workspace name matches the
# repo: a single bazel workspace covering whatever bazel-built work lands
# under ``projects/``. Non-bazel projects (uv Python at ``projects/market``)
# simply have no ``BUILD.bazel`` files and are invisible to bazel.
#
# Add ``bazel_dep(...)`` calls below as you wire in external rules /
# libraries (rules_python, rules_rust, rules_go, rules_oci, etc.).
#
# See https://bazel.build/external/module for the syntax reference.

module(
    name = "quorum",
    version = "0.0.0",
    compatibility_level = 1,
)

bazel_dep(name = "rules_python", version = "0.40.0")

PYTHON_VERSION = "3.12"

# --- Hermetic Python toolchain -------------------------------------------------
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = PYTHON_VERSION,
    is_default = True,
)

# --- Per-project pip dependency hubs ------------------------------------------
# One hub per project keeps dependency sets isolated (a core repo invariant).
# Each reads a fully-pinned lock committed next to that project's BUILD.bazel.
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "slice0_deps",
    python_version = PYTHON_VERSION,
    requirements_lock = "//projects/quorum/slice0:requirements_lock.txt",
)
use_repo(pip, "slice0_deps")

# Slice 0's [llm] extra (torch + transformers + CUDA runtime) lands in the
# LLM backend commit; base + dev is sufficient for substrate, baseline policy,
# metrics, and the Mann-Whitney U merge gate.
