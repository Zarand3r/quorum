*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Data + runtime artifacts
data/
*.duckdb
*.duckdb.wal
*.parquet
logs/
