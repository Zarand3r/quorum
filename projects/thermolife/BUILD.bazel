# thermolife — continuous thermodynamic neural cellular automaton. Bazel graph.
#
# Design only (see PLAN.md): the package is docstring stubs and declarative
# configs, with no external dependencies yet. When Slice 0 code lands (PLAN.md
# §15), add a ``thermolife_deps`` pip hub in MODULE.bazel (numpy, then torch at
# M2) and a ``py_test`` target for the invariant gate (§17).

load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

# Declarative design artifacts (PLAN.md §12) — world / model / curriculum config.
filegroup(
    name = "configs",
    srcs = glob(["configs/*.yaml"]),
)

# Package skeleton: docstring stubs that import nothing external yet.
py_library(
    name = "thermolife",
    srcs = glob(
        ["*.py", "env/**/*.py", "model/**/*.py", "train/**/*.py", "eval/**/*.py", "viz/**/*.py"],
        allow_empty = True,
    ),
    imports = ["."],
)
