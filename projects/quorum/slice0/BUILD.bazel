# quorum Slice 0 — Bazel build graph.
#
# See PLAN.md §15.1 for the design (Boids on 32×32 toroidal grid, N=64, LLM
# backend via vLLM, single batched forward pass per tick).
#
# The [llm] extra (torch + vllm) lands in the requirements lock only when the
# LLM policy commit adds it. Everything else — substrate, prompts, metrics,
# UniformRandomPolicy baseline, tests — is pure Python and needs only the base
# dependencies + [dev] extras.

load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@slice0_deps//:requirements.bzl", "requirement")

package(default_visibility = ["//visibility:public"])

exports_files(["requirements_lock.txt"])

# Base library — pure Python, no torch. Everything except _llm_policy.py.
py_library(
    name = "slice0",
    srcs = glob(["slice0/**/*.py"], exclude = ["slice0/_llm_policy.py"]),
    imports = ["."],
    deps = [
        requirement("numpy"),
        requirement("scipy"),
        requirement("pandas"),
        requirement("pyarrow"),
    ],
)

# Real LLM backend. Kept in a separate target so most builds don't need
# torch/transformers. The base slice0 library imports this lazily via
# ``main.py`` and ``policy.make_llm_policy``.
#
# The nvidia-* CUDA runtime wheels are listed explicitly because torch's
# transitive deps go through the `cuda-toolkit==13.0.2` meta-package, and
# rules_python does not follow the variant-suffix wheels it references —
# torch's own preload sequence (torch/__init__.py:_load_global_deps) then
# raises ``libcudart.so.13: cannot open shared object file`` at import time.
py_library(
    name = "llm_backend",
    srcs = ["slice0/_llm_policy.py"],
    imports = ["."],
    deps = [
        ":slice0",
        requirement("torch"),
        requirement("transformers"),
        requirement("nvidia-cuda-runtime"),
        requirement("nvidia-cuda-nvrtc"),
        requirement("nvidia-cuda-cupti"),
        requirement("nvidia-cublas"),
        requirement("nvidia-cufft"),
        requirement("nvidia-curand"),
        requirement("nvidia-cusolver"),
        requirement("nvidia-cusparse"),
        requirement("nvidia-cufile"),
        requirement("nvidia-nvjitlink"),
        requirement("nvidia-nvtx"),
    ],
)

# CLI runner — accepts --policy uniform_random|llm etc.
py_binary(
    name = "main",
    srcs = ["slice0/main.py"],
    main = "slice0/main.py",
    imports = ["."],
    deps = [
        ":slice0",
        ":llm_backend",
    ],
)

# Success-criteria harness — Mann-Whitney U + replay diff. This is the merge
# gate for the whole slice (PLAN.md §15.1 success criteria).
py_binary(
    name = "verify",
    srcs = ["slice0/verify.py"],
    main = "slice0/verify.py",
    imports = ["."],
    deps = [
        ":slice0",
        ":llm_backend",
    ],
)

py_test(
    name = "test_suite",
    srcs = glob(["tests/**/*.py"]),
    main = "tests/pytest_main.py",
    imports = ["."],
    data = ["pytest.ini"],
    deps = [
        ":slice0",
        ":llm_backend",
        requirement("pytest"),
        requirement("pytest-cov"),
        requirement("hypothesis"),
    ],
)
